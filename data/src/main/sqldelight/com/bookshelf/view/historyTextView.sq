CREATE VIEW historyTextView AS
SELECT
    history._id AS id,
    textbooks._id AS textbookId,
    chapters._id AS chapterId,
    textbooks.title,
    textbooks.thumbnail_url AS thumbnailUrl,
    textbooks.source,
    textbooks.favorite,
    textbooks.cover_last_modified,
    chapters.chapter_number AS chapterNumber,
    history.last_read AS readAt,
    history.time_read AS readDuration,
    max_last_read.last_read AS maxReadAt,
    max_last_read.chapter_id AS maxReadAtChapterId
FROM textbooks
JOIN chapters
ON textbooks._id = chapters.textbook_id
JOIN history
ON chapters._id = history.chapter_id
JOIN (
    SELECT chapters.textbook_id,chapters._id AS chapter_id, MAX(history.last_read) AS last_read
    FROM chapters JOIN history
    ON chapters._id = history.chapter_id
    GROUP BY chapters.textbook_id
) AS max_last_read
ON chapters.textbook_id = max_last_read.textbook_id;

history:
SELECT
id,
textbookId,
chapterId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
chapterNumber,
readAt,
readDuration
FROM historyTextView
WHERE historyTextView.readAt > 0
AND maxReadAtChapterId = historyTextView.chapterId
AND lower(historyTextView.title) LIKE ('%' || :query || '%')
ORDER BY readAt DESC;

getLatestHistory:
SELECT
id,
textbookId,
chapterId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
chapterNumber,
readAt,
readDuration
FROM historyTextView
WHERE historyTextView.readAt > 0
ORDER BY readAt DESC
LIMIT 1;
