CREATE VIEW updatesTextView AS
SELECT
    textbooks._id AS textbookId,
    textbooks.title AS textbookTitle,
    chapters._id AS chapterId,
    chapters.name AS chapterName,
    chapters.scanlator,
    chapters.url AS chapterUrl,
    chapters.read,
    chapters.bookmark,
    chapters.last_page_read,
    textbooks.source,
    textbooks.favorite,
    textbooks.thumbnail_url AS thumbnailUrl,
    textbooks.cover_last_modified AS coverLastModified,
    chapters.date_upload AS dateUpload,
    chapters.date_fetch AS datefetch,
    excluded_scanlators.scanlator AS excludedScanlator
FROM textbooks JOIN chapters
ON textbooks._id = chapters.textbook_id
LEFT JOIN excluded_scanlators
ON textbooks._id = excluded_scanlators.textbook_id
AND chapters.scanlator = excluded_scanlators.scanlator
WHERE favorite = 1
AND date_fetch > date_added
ORDER BY date_fetch DESC;

getRecentUpdates:
SELECT *
FROM updatesTextView
WHERE dateUpload > :after
LIMIT :limit;

getRecentUpdatesWithFilters:
SELECT *
FROM updatesTextView
WHERE dateUpload > :after
AND (:read IS NULL OR read = :read)
-- Started means some progress but not finished, Read means finished chapter, thus:
AND (
    :started IS NULL
    OR (:started = 1 AND last_page_read > 0 AND read = 0)
    OR (:started = 0 AND last_page_read = 0 AND read = 0)
)
AND (:bookmarked IS NULL OR bookmark = :bookmarked)
AND (
    (excludedScanlator IS NULL OR :hideExcludedScanlators = 0)
)
AND (
    -- includedEmpty being true expresses "don't care" state and bypasses the membership filter
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM textbooks_categories
        WHERE textbooks_categories.textbook_id = textbookId
        AND COALESCE(textbooks_categories.category_id, 0) IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM textbooks_categories mc WHERE mc.textbook_id = textbookId)
    )
)
AND (
    -- excludedEmpty being true expresses "don't care" state and bypasses the membership filter
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM textbooks_categories
            WHERE textbooks_categories.textbook_id = textbookId
            AND COALESCE(textbooks_categories.category_id, 0) IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM textbooks_categories WHERE textbooks_categories.textbook_id = textbookId)
        )
    )
)
LIMIT :limit;

getUpdatesByReadStatus:
SELECT *
FROM updatesTextView
WHERE read = :read
AND dateUpload > :after
LIMIT :limit;
