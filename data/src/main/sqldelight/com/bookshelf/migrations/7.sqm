-- Add chapter urls to updates view
DROP VIEW IF EXISTS updatesTextView;
CREATE VIEW updatesTextView AS
SELECT
    textbooks._id AS textbookId,
    textbooks.title AS textbookTitle,
    chapters._id AS chapterId,
    chapters.name AS chapterName,
    chapters.scanlator,
    chapters.url AS chapterUrl,
    chapters.read,
    chapters.bookmark,
    chapters.last_page_read,
    textbooks.source,
    textbooks.favorite,
    textbooks.thumbnail_url AS thumbnailUrl,
    textbooks.cover_last_modified AS coverLastModified,
    chapters.date_upload AS dateUpload,
    chapters.date_fetch AS datefetch
FROM textbooks JOIN chapters
ON textbooks._id = chapters.textbook_id
WHERE favorite = 1
AND date_fetch > date_added
ORDER BY date_fetch DESC;
