CREATE TABLE textbooks_categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    textbook_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    FOREIGN KEY(category_id) REFERENCES categories (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(textbook_id) REFERENCES textbooks (_id)
    ON DELETE CASCADE
);

CREATE INDEX idx_textbooks_categories_textbook_id ON textbooks_categories(textbook_id);
CREATE INDEX idx_textbooks_categories_category_id ON textbooks_categories(category_id);

CREATE TRIGGER insert_textbook_category_update_version AFTER INSERT ON textbooks_categories
BEGIN
    UPDATE textbooks
    SET version = version + 1
    WHERE _id = new.textbook_id AND (SELECT is_syncing FROM textbooks WHERE _id = new.textbook_id) = 0;
END;

insert:
INSERT INTO textbooks_categories(textbook_id, category_id)
VALUES (:textbookId, :categoryId);

deleteTextbookCategoryByTextbookId:
DELETE FROM textbooks_categories
WHERE textbook_id = :textbookId;