-- Migration to add performance indexes

CREATE INDEX IF NOT EXISTS idx_textbooks_source ON textbooks(source);
CREATE INDEX IF NOT EXISTS idx_chapters_url ON chapters(url);
CREATE INDEX IF NOT EXISTS idx_textbooks_categories_textbook_id ON textbooks_categories(textbook_id);
CREATE INDEX IF NOT EXISTS idx_mangas_categories_category_id ON textbooks_categories(category_id);
CREATE INDEX IF NOT EXISTS idx_excluded_scanlators_scanlator ON excluded_scanlators(scanlator);
CREATE INDEX IF NOT EXISTS idx_textbook_sync_textbook_id ON textbook_sync(textbook_id);
CREATE INDEX IF NOT EXISTS idx_history_last_read ON history(last_read);
