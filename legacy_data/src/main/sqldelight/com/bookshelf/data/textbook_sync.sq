import kotlin.Boolean;

CREATE TABLE textbook_sync(
    _id INTEGER NOT NULL PRIMARY KEY,
    textbook_id INTEGER NOT NULL,
    sync_id INTEGER NOT NULL,
    remote_id INTEGER NOT NULL,
    library_id INTEGER,
    title TEXT NOT NULL,
    last_chapter_read REAL NOT NULL,
    total_chapters INTEGER NOT NULL,
    status INTEGER NOT NULL,
    score REAL NOT NULL,
    remote_url TEXT NOT NULL,
    start_date INTEGER NOT NULL,
    finish_date INTEGER NOT NULL,
    private INTEGER AS Boolean DEFAULT 0 NOT NULL,
    UNIQUE (textbook_id, sync_id) ON CONFLICT REPLACE,
    FOREIGN KEY(textbook_id) REFERENCES textbooks (_id)
    ON DELETE CASCADE
);

CREATE INDEX idx_textbook_sync_textbook_id ON textbook_sync(textbook_id);

delete:
DELETE FROM textbook_sync
WHERE textbook_id = :textbookId AND sync_id = :syncId;

getTracks:
SELECT *
FROM textbook_sync;

getTrackById:
SELECT *
FROM textbook_sync
WHERE _id = :id;

getTracksByTextbookId:
SELECT *
FROM textbook_sync
WHERE textbook_id = :textbookId;

insert:
INSERT INTO textbook_sync(textbook_id,sync_id,remote_id,library_id,title,last_chapter_read,total_chapters,status,score,remote_url,start_date,finish_date,private)
VALUES (:textbookId,:syncId,:remoteId,:libraryId,:title,:lastChapterRead,:totalChapters,:status,:score,:remoteUrl,:startDate,:finishDate,:private);

update:
UPDATE textbook_sync
SET
    textbook_id = coalesce(:textbookId, textbook_id),
    sync_id = coalesce(:syncId, sync_id),
    remote_id = coalesce(:mediaId, remote_id),
    library_id = coalesce(:libraryId, library_id),
    title = coalesce(:title, title),
    last_chapter_read = coalesce(:lastChapterRead, last_chapter_read),
    total_chapters = coalesce(:totalChapter, total_chapters),
    status = coalesce(:status, status),
    score = coalesce(:score, score),
    remote_url = coalesce(:trackingUrl, remote_url),
    start_date = coalesce(:startDate, start_date),
    finish_date = coalesce(:finishDate, finish_date),
    private = coalesce(:private, private)
WHERE _id = :id;
