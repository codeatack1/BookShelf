CREATE TABLE excluded_scanlators(
    textbook_id INTEGER NOT NULL,
    scanlator TEXT NOT NULL,
    FOREIGN KEY(textbook_id) REFERENCES textbooks (_id)
    ON DELETE CASCADE
);

CREATE INDEX excluded_scanlators_textbook_id_index ON excluded_scanlators(textbook_id);
CREATE INDEX idx_excluded_scanlators_scanlator ON excluded_scanlators(scanlator);

insert:
INSERT INTO excluded_scanlators(textbook_id, scanlator)
VALUES (:textbookId, :scanlator);

remove:
DELETE FROM excluded_scanlators
WHERE textbook_id = :textbookId
AND scanlator IN :scanlators;

getExcludedScanlatorsByTextbookId:
SELECT scanlator
FROM excluded_scanlators
WHERE textbook_id = :textbookId;
